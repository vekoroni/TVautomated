+                profile_type="INSUFFICIENT_DATA", balance="UNKNOWN",
+                tpo_distribution={}, timestamp=pd.Timestamp.now(tz="UTC"),
+                timeframe="GOVERNED",
+            ),
+            acceptance=AcceptanceState(
