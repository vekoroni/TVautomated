    def scan_options(self):
        """
        Main scan: Detect Wyckoff patterns and export to CSV
        
        NO options liquidity validation - that happens in Colab
        Focus: 100% accurate Wyckoff detection, capture moves just as they start
        """
        print(f"  [Options] Starting scan - {self.preset_name}")
        print(f"  [Options] Mode: PATTERN DETECTION ONLY (No liquidity validation)")
        print(f"  [Options] Using Wyckoff Engine v2.0 - Export to CSV for Colab validation")
        print(f"  [Options] Focus: Grade A/B patterns with timing readiness")
        
        if not self.polygon_key or self.polygon_key == 'your_polygon_key_here':
            return {'status': 'error', 'message': 'POLYGON_API_KEY not configured', 'signals': []}
        
        # Get universe
        tickers, source = self._get_universe()
        print(f"  [Options] Scanning {len(tickers)} tickers ({source} universe)")
        
        signals = []
        scanned = 0
        patterns_found = 0
        liquidity_passed = 0
        liquidity_failed = 0
        grade_a_count = 0
        grade_b_count = 0
        
        for ticker in tickers:
            try:
                # Phase 1: Stock technical analysis (NEW ENGINE)
                stock_signal = self._scan_ticker_stock(ticker)
                if not stock_signal:
                    scanned += 1
                    continue
                
                patterns_found += 1
                
                # Track grades
                if stock_signal.get('setup_quality') == 'Grade_A':
                    grade_a_count += 1
                elif stock_signal.get('setup_quality') == 'Grade_B':
                    grade_b_count += 1
                
                # Phase 2: NO LIQUIDITY VALIDATION - Export all Wyckoff patterns
                # Add timing readiness indicator
                timing_readiness = self._assess_timing_readiness(stock_signal)
                signal = {**stock_signal, 'timing_readiness': timing_readiness}
                
                signals.append(signal)
                liquidity_passed += 1
                
                print(f"  [Options] ✓ {ticker} {signal['setup_quality']} {signal['setup']} "
                      f"(Score {signal['wyckoff_score']:.1f}, Timing: {timing_readiness})")
                
                scanned += 1
                
                if scanned % 100 == 0:
                    print(f"  [Options] Progress: {scanned}/{len(tickers)} - "
                          f"{liquidity_passed} tradable, {liquidity_failed} failed liquidity")
                
                time.sleep(0.12)
                
            except Exception as e:
                scanned += 1
                continue
        
        print(f"\n  [Options] SCAN COMPLETE:")
        print(f"    Tickers scanned: {scanned}")
        print(f"    Wyckoff patterns: {patterns_found}")
        print(f"    - Grade A: {grade_a_count}")
        print(f"    - Grade B: {grade_b_count}")
        print(f"    Patterns exported: {liquidity_passed}")
        print(f"    Failed filters: {liquidity_failed}")
        if patterns_found > 0:
            print(f"    Pattern rate: {(patterns_found/scanned*100):.1f}%")
        
        # Export to CSV
        if signals:
            csv_path = self._export_signals_to_csv(signals)
            print(f"\n  ✅ Exported {len(signals)} patterns to: {csv_path}")
        
        return {
            'status': 'success',
            'signal_count': liquidity_passed,
            'signals': signals,
            'stats': {
                'tickers_scanned': scanned,
                'patterns_found': patterns_found,
                'grade_a_setups': grade_a_count,
                'grade_b_setups': grade_b_count,
                'patterns_exported': liquidity_passed,
                'dte_range': f"{self.min_dte}-{self.max_dte}",
                'preset': self.preset_name
            },
            'universe_source': source,
            'timestamp': datetime.now().isoformat()
        }
    
    def _scan_ticker_stock(self, ticker):
        """Phase 1: Stock technical analysis using NEW Wyckoff Engine"""
        
        # Get price history
        price_data = self._get_price_history(ticker, days=90)
        if not price_data or len(price_data) < 30:
            return None
        
        # Convert to DataFrame for new engine
        df = pd.DataFrame(price_data)
        df = df.rename(columns={'timestamp': 'date'})
        
        # NEW: Run Wyckoff Engine analysis
        wyckoff_result = self.wyckoff_engine.analyze(ticker, df)
        
        # Filter: Only Grade A and B setups
        if wyckoff_result['setup_quality'] not in ['Grade_A', 'Grade_B']:
            return None
        
        # Filter: Only if wyckoff_score >= 70
        if wyckoff_result['wyckoff_score'] < 70:
            return None
        
        # Filter: Must have a trade direction
        if wyckoff_result['trade_direction'] == 'NONE':
            return None
        
        # Map direction to CALL/PUT for options
        direction = 'CALL' if wyckoff_result['trade_direction'] == 'LONG' else 'PUT'
        
        # Get current price
        current_price = price_data[-1]['close']
        
        return {
            'ticker': ticker,
            'setup': wyckoff_result['phase'],
            'setup_quality': wyckoff_result['setup_quality'],
            'direction': direction,
            'wyckoff_score': wyckoff_result['wyckoff_score'],
            'confidence': wyckoff_result['confidence'],
            'stock_price': round(current_price, 2),
            'entry_trigger': wyckoff_result['entry_trigger'],
            'stop_loss': wyckoff_result['stop_loss'],
            'initial_target': wyckoff_result['initial_target'],
            'thrust_pattern': wyckoff_result['thrust_pattern'],
            'volume_activity': wyckoff_result['volume_activity'],
            'warnings': wyckoff_result['warnings'],
        }
    
    def _select_strikes_2above_5below(self, snapshots, current_price):
        """
        NEW: Select strikes using 2-above-5-below strategy
        Works with snapshot objects, not contract dictionaries
        """
        if not snapshots or not current_price:
            return snapshots
        
        # Extract unique strikes and map to snapshots
        strikes_set = set()
        strike_to_snapshots = {}
        
        for snap in snapshots:
            try:
                strike = float(snap.details.strike_price)
                strikes_set.add(strike)
                
                if strike not in strike_to_snapshots:
                    strike_to_snapshots[strike] = []
                strike_to_snapshots[strike].append(snap)
            except:
                pass
        
        strikes = sorted(list(strikes_set))
        
        if len(strikes) == 0:
            return []
        
        # Find strikes above and below current price
        strikes_above = [s for s in strikes if s > current_price]
        strikes_below = [s for s in strikes if s <= current_price]
        
        # Select 2 strikes above (closest to current price)
        selected_above = strikes_above[:2] if len(strikes_above) >= 2 else strikes_above
        
        # Select 5 strikes below (closest to current price, working downward)
        selected_below = strikes_below[-5:] if len(strikes_below) >= 5 else strikes_below
        
        # Combine selected strikes
        selected_strikes = set(selected_above + selected_below)
        
        # Get all snapshots at these strikes
        filtered_snapshots = []
        for strike in selected_strikes:
            if strike in strike_to_snapshots:
                filtered_snapshots.extend(strike_to_snapshots[strike])
        
        return filtered_snapshots
    
    def _find_tradable_option(self, ticker, stock_signal):
        """
        Phase 2: Find tradable option using SNAPSHOT CHAIN approach
        
        This is the NEW method that mirrors our successful test:
        - ONE API call gets ALL option data
        - Only returns options with active quotes
        - Much faster and more reliable
        """
        
        try:
            current_price = stock_signal['stock_price']
            direction = stock_signal['direction']
            
            print(f"    [DEBUG] {ticker}: Fetching snapshot chain...")
            
            # NEW: Get ALL options data in ONE API call (like our test!)
            all_snapshots = list(self.polygon_client.list_snapshot_options_chain(ticker))
            
            print(f"    [DEBUG] {ticker}: Got {len(all_snapshots)} option snapshots")
            
            if not all_snapshots:
                print(f"    [DEBUG] {ticker}: No options available")
                return None
            
            # Filter by contract type (CALL/PUT)
            contract_type = 'call' if direction == 'CALL' else 'put'
            type_filtered = [snap for snap in all_snapshots 
                           if snap.details.contract_type.lower() == contract_type]
            
            print(f"    [DEBUG] {ticker}: {len(type_filtered)} {contract_type.upper()}s")
            
            if not type_filtered:
                return None
            
            # Filter by DTE
            today = datetime.now()
            min_date = today + timedelta(days=self.min_dte)
            max_date = today + timedelta(days=self.max_dte)
            
            dte_filtered = []
            for snap in type_filtered:
                try:
                    exp_date = datetime.strptime(snap.details.expiration_date, '%Y-%m-%d')
                    dte = (exp_date - today).days
                    
                    if self.min_dte <= dte <= self.max_dte:
                        dte_filtered.append(snap)
                except:
                    pass
            
            print(f"    [DEBUG] {ticker}: {len(dte_filtered)} in DTE range ({self.min_dte}-{self.max_dte} days)")
            
            if not dte_filtered:
                return None
            
            # Apply 2-above-5-below strike selection
            strike_filtered = self._select_strikes_2above_5below(dte_filtered, current_price)
            
            print(f"    [DEBUG] {ticker}: {len(strike_filtered)} after strike selection")
            
            if not strike_filtered:
                return None
            
            # Sort by expiration (nearest first)
            strike_filtered.sort(key=lambda x: x.details.expiration_date)
            
            # Try to find a liquid option
            checked = 0
            for snap in strike_filtered:
                checked += 1
                
                # Extract quote data
                quote = self._extract_quote_from_snapshot(snap)
                
                if not quote:
                    if checked <= 3:  # Debug first 3 failures
                        print(f"    [DEBUG] {ticker}: Contract {checked} - No quote extracted")
                    continue
                
                # DEBUG: Show what we got for first 3 contracts
                if checked <= 3:
                    print(f"    [DEBUG] {ticker}: Contract {checked} - Bid=${quote.get('bid',0):.2f}, Ask=${quote.get('ask',0):.2f}, Spread={quote.get('spread_pct',999):.1f}%, Vol={quote.get('volume',0)}, OI={quote.get('open_interest',0)}, Delta={quote.get('delta',0):.3f}")
                
                # Validate liquidity (with debug for first 3)
                if not self._validate_option_liquidity(quote, debug_ticker=ticker if checked <= 3 else None):
                    continue
                
                # SUCCESS - Found tradable option!
                exp_date = datetime.strptime(snap.details.expiration_date, '%Y-%m-%d')
                dte = (exp_date - datetime.now()).days
                
                print(f"    [DEBUG] {ticker}: ✅ Found tradable option: {snap.details.ticker}")
                
                return {
                    'option_symbol': snap.details.ticker,
                    'strike': snap.details.strike_price,
                    'expiry': snap.details.expiration_date,
                    'dte': dte,
                    'option_bid': quote['bid'],
                    'option_ask': quote['ask'],
                    'option_mid': quote['mid'],
                    'spread_pct': quote['spread_pct'],
                    'delta': quote.get('delta', 0),
                    'gamma': quote.get('gamma', 0),
                    'theta': quote.get('theta', 0),
                    'vega': quote.get('vega', 0),
                    'iv': quote.get('iv', 0),
                    'volume': quote.get('volume', 0),
                    'open_interest': quote.get('open_interest', 0),
                    'theta_pct_per_day': abs(quote.get('theta', 0) / quote['mid'] * 100) if quote['mid'] > 0 else 0,
                }
            
            print(f"    [DEBUG] {ticker}: No liquid options found after checking {len(strike_filtered)} contracts")
            return None
            
        except Exception as e:
            print(f"    [DEBUG] {ticker}: ERROR in _find_tradable_option - {type(e).__name__}: {str(e)}")
            return None
    
    def _extract_quote_from_snapshot(self, snap):
        """
        Extract quote data from a Polygon snapshot object
        
        This converts the snapshot format to our internal quote format
        """
        try:
            # Get bid/ask from last_quote
            if not hasattr(snap, 'last_quote') or not snap.last_quote:
                return None
            
            bid = snap.last_quote.bid if hasattr(snap.last_quote, 'bid') else 0
            ask = snap.last_quote.ask if hasattr(snap.last_quote, 'ask') else 0
            
            if bid <= 0 or ask <= 0:
                return None
            
            mid = (bid + ask) / 2
            spread_pct = ((ask - bid) / mid * 100) if mid > 0 else 999
            
            # Get Greeks
            greeks = snap.greeks if hasattr(snap, 'greeks') else None
            delta = greeks.delta if greeks and hasattr(greeks, 'delta') else 0
            gamma = greeks.gamma if greeks and hasattr(greeks, 'gamma') else 0
            theta = greeks.theta if greeks and hasattr(greeks, 'theta') else 0
            vega = greeks.vega if greeks and hasattr(greeks, 'vega') else 0
            
            # Get volume and OI
            volume = snap.day.volume if hasattr(snap, 'day') and snap.day and hasattr(snap.day, 'volume') else 0
            open_interest = snap.open_interest if hasattr(snap, 'open_interest') else 0
            
            # Get IV
            iv = snap.implied_volatility if hasattr(snap, 'implied_volatility') else 0
            
            return {
                'bid': bid,
                'ask': ask,
                'mid': mid,
                'spread_pct': spread_pct,
                'delta': delta,
                'gamma': gamma,
                'theta': theta,
                'vega': vega,
                'iv': iv,
                'volume': volume,
                'open_interest': open_interest
            }
            
        except Exception as e:
            return None
    
    def _validate_option_liquidity(self, quote, debug_ticker=None):
        """Validate if option meets liquidity requirements - with debug"""
        
        failures = []
        
        # Check bid price
        if quote['bid'] < self.min_bid_price:
            failures.append(f"Bid ${quote['bid']:.2f} < ${self.min_bid_price}")
            if not debug_ticker:
                return False
        
        # Check spread
        if quote['spread_pct'] > self.max_spread_pct:
            failures.append(f"Spread {quote['spread_pct']:.1f}% > {self.max_spread_pct}%")
            if not debug_ticker:
                return False
        
        # Check volume
        if quote.get('volume', 0) < self.min_option_volume:
            failures.append(f"Volume {quote.get('volume', 0)} < {self.min_option_volume}")
            if not debug_ticker:
                return False
        
        # Check open interest
        if quote.get('open_interest', 0) < self.min_open_interest:
            failures.append(f"OI {quote.get('open_interest', 0)} < {self.min_open_interest}")
            if not debug_ticker:
                return False
        
        # Check delta range
        delta = abs(quote.get('delta', 0))
        if delta > 0:
            if delta < self.min_delta or delta > self.max_delta:
                failures.append(f"Delta {delta:.3f} not in {self.min_delta}-{self.max_delta}")
                if not debug_ticker:
                    return False
        else:
            failures.append(f"Delta missing or zero")
            if not debug_ticker:
                return False
        
        # Check theta decay (if available)
        theta = abs(quote.get('theta', 0))
        if theta > 0 and quote['mid'] > 0:
            theta_pct = theta / quote['mid'] * 100
            if theta_pct > self.max_theta_pct:
                failures.append(f"Theta {theta_pct:.1f}%/day > {self.max_theta_pct}%")
                if not debug_ticker:
                    return False
        
        # If debug mode, print all failures
        if debug_ticker and failures:
            print(f"    [DEBUG] {debug_ticker}: Validation FAILED - {', '.join(failures)}")
            return False
        
        return True
    
    def _assess_timing_readiness(self, signal):
        """
        Assess how ready the setup is to move - captures "just as move is about to start"
        
        Returns:
            IMMEDIATE: Enter now, pattern confirmed and ready
            NEAR_TERM: Setup forming, watch for entry in 1-3 days
            DEVELOPING: Pattern detected but needs more confirmation
        """
        entry_trigger = signal.get('entry_trigger', '').lower()
        wyckoff_score = signal.get('wyckoff_score', 0)
        setup_quality = signal.get('setup_quality', '')
        
        # IMMEDIATE - Move is starting NOW
        if 'immediately' in entry_trigger or 'enter now' in entry_trigger:
            return 'IMMEDIATE'
        
        # IMMEDIATE - Grade A with high score and test confirmation
        if setup_quality == 'Grade_A' and wyckoff_score >= 90:
            if 'tested' in entry_trigger or 'confirmed' in entry_trigger:
                return 'IMMEDIATE'
        
        # NEAR_TERM - Good setup, wait for specific entry point
        if 'on next' in entry_trigger or 'on pullback' in entry_trigger or 'on rally' in entry_trigger:
            if wyckoff_score >= 80:
                return 'NEAR_TERM'
        
        # DEVELOPING - Pattern detected but needs more time
        return 'DEVELOPING'
    
    def _export_signals_to_csv(self, signals):
        """
        Export all Wyckoff patterns to CSV for Colab validation
        
        CSV includes all pattern data for liquidity validation and review
        """
        from pathlib import Path
        import csv as csv_module
        
        # Create reports directory if it doesn't exist
        reports_dir = Path('reports')
        reports_dir.mkdir(exist_ok=True)
        
        # Generate filename with timestamp
        timestamp = datetime.now().strftime('%Y-%m-%d_%H%M')
        csv_path = reports_dir / f'wyckoff_patterns_{timestamp}.csv'
        
        # Define CSV columns
        fieldnames = [
            'ticker',
            'direction',
            'setup',
            'setup_quality',
            'wyckoff_score',
            'confidence',
            'timing_readiness',
            'stock_price',
            'entry_trigger',
            'stop_loss',
            'initial_target',
            'thrust_pattern',
            'volume_activity',
            'warnings',
            'scan_date'
        ]
        
        # Write CSV
        with open(csv_path, 'w', newline='', encoding='utf-8') as f:
            writer = csv_module.DictWriter(f, fieldnames=fieldnames)
            writer.writeheader()
            
            for signal in signals:
                # Format warnings list as string
                warnings = signal.get('warnings', [])
                warnings_str = '; '.join(warnings) if warnings else 'None'
                
                row = {
                    'ticker': signal.get('ticker', ''),
                    'direction': signal.get('direction', ''),
                    'setup': signal.get('setup', ''),
                    'setup_quality': signal.get('setup_quality', ''),
                    'wyckoff_score': signal.get('wyckoff_score', 0),
                    'confidence': signal.get('confidence', 0),
                    'timing_readiness': signal.get('timing_readiness', ''),
                    'stock_price': signal.get('stock_price', 0),
                    'entry_trigger': signal.get('entry_trigger', ''),
                    'stop_loss': signal.get('stop_loss', 0),
                    'initial_target': signal.get('initial_target', 0),
                    'thrust_pattern': signal.get('thrust_pattern', ''),
                    'volume_activity': signal.get('volume_activity', ''),
                    'warnings': warnings_str,
                    'scan_date': datetime.now().strftime('%Y-%m-%d')
                }
                
                writer.writerow(row)
        
        return str(csv_path)
    
    def _get_universe(self):
        """Get ticker universe"""
        if self.csv_path.exists():
            try:
                tickers = self._load_csv()
                if tickers:
                    return tickers, 'CSV'
            except:
                pass
        
        try:
            tickers = self._fetch_dynamic_universe()
            if tickers and len(tickers) > 50:
                return tickers, 'Dynamic'
        except:
            pass
        
        return self._get_static_universe(), 'Static'
    
    def _load_csv(self):
        """Load tickers from CSV"""
        tickers = []
        with open(self.csv_path, 'r', encoding='utf-8') as f:
            reader = csv.DictReader(f)
            for row in reader:
                ticker = row.get('ticker', '').strip().upper()
                if ticker and len(ticker) <= 5:
                    tickers.append(ticker)
        return tickers
    
    def _fetch_dynamic_universe(self):
        """Fetch top 500 liquid tickers"""
        url = f"{self.base_url}/v2/snapshot/locale/us/markets/stocks/tickers"
        params = {'apiKey': self.polygon_key}
        
        response = requests.get(url, params=params, timeout=30)
        response.raise_for_status()
        data = response.json()
        
        if 'tickers' not in data:
            raise Exception("No tickers")
        
        candidates = []
        for item in data['tickers']:
            ticker = item.get('ticker', '')
            day = item.get('day', {})
            
            if not day:
                continue
            
            price = day.get('c', 0)
            volume = day.get('v', 0)
            
            if (volume > 500000 and 10 <= price <= 2000 and '.' not in ticker and 
                '-' not in ticker and len(ticker) <= 5 and ticker.isalpha()):
                candidates.append({'ticker': ticker, 'volume': volume})
        
        candidates.sort(key=lambda x: x['volume'], reverse=True)
        return [c['ticker'] for c in candidates[:500]]
    
