    def _load_macro_data_from_csvs(self):
        """
        Fallback: Load macro data from CSVs if report not available
        """
        print(f"\n  [Macro] Loading from CSVs (fallback mode)")
        
        if not self.macro_folder.exists():
            print(f"  [Macro] ⚠️  Folder not found: {self.macro_folder}")
            return None
        
        macro_data = {
            'risk_on_prob': None,
            'liquidity_status': None,
            'vix_contango': None
        }
        
        try:
            # Find regime CSV
            regime_files = list(self.macro_folder.glob('*regime*.csv'))
            if regime_files:
                regime_file = max(regime_files, key=lambda p: p.stat().st_mtime)
                regime_df = pd.read_csv(regime_file)
                
                prob_col = None
                for col in ['probability', 'risk_on_prob', 'risk_on', 'regime_prob']:
                    if col in regime_df.columns:
                        prob_col = col
                        break
                
                if prob_col and len(regime_df) > 0:
                    macro_data['risk_on_prob'] = regime_df[prob_col].iloc[-1]
                    print(f"  [Macro] ✓ Risk-On: {macro_data['risk_on_prob']:.1%}")
            
            # Find liquidity CSV
            liquidity_files = list(self.macro_folder.glob('*liquidity*.csv'))
            if liquidity_files:
                liq_file = max(liquidity_files, key=lambda p: p.stat().st_mtime)
                liq_df = pd.read_csv(liq_file)
                
                if 'status' in liq_df.columns and len(liq_df) > 0:
                    macro_data['liquidity_status'] = liq_df['status'].iloc[-1]
                elif 'liquidity_change' in liq_df.columns and len(liq_df) > 0:
                    change = liq_df['liquidity_change'].iloc[-1]
                    if change > 50:
                        macro_data['liquidity_status'] = 'FLOODED'
                    elif change < -50:
                        macro_data['liquidity_status'] = 'DRAINING'
                    else:
                        macro_data['liquidity_status'] = 'NEUTRAL'
                
                print(f"  [Macro] ✓ Liquidity: {macro_data['liquidity_status']}")
            
            # Find VIX CSV
            vix_files = [f for f in self.macro_folder.glob('*vix*.csv') if 'curve' in f.name.lower()]
            if vix_files:
                vix_file = max(vix_files, key=lambda p: p.stat().st_mtime)
                vix_df = pd.read_csv(vix_file)
                
                if 'contango_pct' in vix_df.columns and len(vix_df) > 0:
                    macro_data['vix_contango'] = vix_df['contango_pct'].iloc[-1] / 100
                elif len(vix_df) >= 2 and 'price' in vix_df.columns:
                    vix_front = vix_df.iloc[0]['price']
                    vix_back = vix_df.iloc[1]['price']
                    if vix_front > 0:
                        macro_data['vix_contango'] = (vix_back / vix_front) - 1
                
                print(f"  [Macro] ✓ VIX Contango: {macro_data.get('vix_contango', 0):.1%}")
            
            return macro_data
            
        except Exception as e:
            print(f"  [Macro] ⚠️  Error loading CSVs: {e}")
            return None

