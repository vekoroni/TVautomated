    def _validate_macro_regime(self, macro_data):
        """Validate macro environment"""
        if macro_data is None:
            return 'YELLOW', 0.50, "No macro data - proceed with caution"
        
        risk_on = macro_data.get('risk_on_prob', 0.50)
        liquidity = macro_data.get('liquidity_status', 'UNKNOWN')
        vix_contango = macro_data.get('vix_contango', 0.0)
        
        print(f"\n  [Macro] REGIME ASSESSMENT:")
        print(f"    Risk-On: {risk_on:.1%} (need ≥70% for GREEN)")
        print(f"    Liquidity: {liquidity} (need FLOODED for GREEN)")
        print(f"    VIX Contango: {vix_contango:.1%} (need ≥12% for GREEN)")
        
        # GREEN: All systems go
        if (risk_on >= self.risk_on_threshold and 
            liquidity == 'FLOODED' and 
            vix_contango >= self.vix_contango_threshold):
            print(f"  [Macro] ✅ REGIME: GREEN (Optimal conditions)")
            return 'GREEN', 1.0, "All macro conditions favorable"
        
        # YELLOW: Mixed
        elif risk_on >= 0.60 and liquidity != 'DRAINING':
            print(f"  [Macro] ⚠️  REGIME: YELLOW (Mixed conditions)")
            return 'YELLOW', 0.50, "Proceed with caution - defensive only"
        
        # RED: Abort
        else:
            print(f"  [Macro] 🔴 REGIME: RED (Hostile conditions)")
            return 'RED', 0.25, "Macro headwinds - minimal trading"

    def _apply_sector_rules(self, ticker, sector, regime, liquidity_status):
        """Apply sector-specific rules"""
        # Tech needs liquidity
        if sector == 'TECH':
            if liquidity_status == 'DRAINING':
                return False, "Tech requires liquidity (currently DRAINING)", 0.0
            elif liquidity_status == 'NEUTRAL' and regime != 'GREEN':
                return False, "Tech requires FLOODED liquidity or GREEN regime", 0.0
        
        # Only defensives in YELLOW/RED
        if regime in ['YELLOW', 'RED']:
            if sector not in ['DEFENSIVE', 'COMMODITY', 'BONDS']:
                return False, f"Only defensives allowed in {regime} regime", 0.0
        
        return True, "Sector rules passed", 1.0

    def _calculate_win_probability(self, wyckoff_score, regime, liquidity_status, warnings):
        """Calculate win probability for 80% targeting"""
        base_prob = min(wyckoff_score / 100, 0.75)
        
        macro_adj = 0.0
        if regime == 'GREEN':
            macro_adj += 0.10
        elif regime == 'YELLOW':
            macro_adj += 0.00
        elif regime == 'RED':
            macro_adj -= 0.15
        
        if warnings:
            macro_adj -= len(warnings) * 0.05
        
        win_prob = max(0.0, min(1.0, base_prob + macro_adj))
        return round(win_prob, 3)

    # ========================================================================
    # CRABEL & WYCKOFF SCANNING (Same as v2.0)
    # ========================================================================

    def _calculate_atr(self, df, period):
        """Calculate ATR"""
        if len(df) < period + 1:
            return None
        df = df.copy()
        df['h-l'] = df['high'] - df['low']
        df['h-pc'] = abs(df['high'] - df['close'].shift(1))
        df['l-pc'] = abs(df['low'] - df['close'].shift(1))
        df['tr'] = df[['h-l', 'h-pc', 'l-pc']].max(axis=1)
        atr = df['tr'].rolling(window=period).mean()
        return atr.iloc[-1] if not pd.isna(atr.iloc[-1]) else None

    def _apply_crabel_compression_filter(self, tickers):
        """Crabel compression filter"""
        print(f"\n  [Crabel] COMPRESSION FILTER")
        print(f"  [Crabel] Threshold: ATR7/ATR20 < {self.crabel_compression_threshold}")
        print(f"  [Crabel] Scanning {len(tickers)} tickers...")

        compressed_tickers = []
        scanned = 0
        start_time = time.time()

        for ticker in tickers:
            try:
                price_data = self._get_price_history(ticker, days=60)
                if not price_data or len(price_data) < 25:
                    scanned += 1
                    continue

                df = pd.DataFrame(price_data)
                atr7 = self._calculate_atr(df, 7)
                atr20 = self._calculate_atr(df, 20)

                if atr7 is None or atr20 is None or atr20 == 0:
                    scanned += 1
                    continue

                compression_ratio = atr7 / atr20

                if compression_ratio < self.crabel_compression_threshold:
                    compressed_tickers.append({
                        'ticker': ticker,
                        'compression': compression_ratio,
                        'atr7': atr7,
                        'atr20': atr20,
                        'current_price': price_data[-1]['close']
                    })

                scanned += 1

                if scanned % 100 == 0:
                    elapsed = time.time() - start_time
                    rate = scanned / elapsed
                    remaining = (len(tickers) - scanned) / rate if rate > 0 else 0
                    print(f"  [Crabel] Progress: {scanned}/{len(tickers)} - "
                          f"{len(compressed_tickers)} compressed - ETA: {remaining/60:.1f}m")

                time.sleep(0.05)

            except Exception as e:
                scanned += 1
                continue

        elapsed = time.time() - start_time
        print(f"\n  [Crabel] Complete: {len(compressed_tickers)} compressed ({elapsed/60:.1f}m)")
        
        compressed_tickers.sort(key=lambda x: x['compression'])
        return [item['ticker'] for item in compressed_tickers]

