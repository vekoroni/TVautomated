    def _find_intelligence_report(self):
        """
        Find latest intelligence report PDF in reports/daily/
        
        Looks for any PDF with "macro" in filename
        Returns newest by modification time
        """
        if not self.macro_folder.exists():
            return None
        
        # Find all PDFs with "macro" in name
        pdf_files = list(self.macro_folder.glob('*macro*.pdf'))
        
        if not pdf_files:
            return None
        
        # Return newest
        return max(pdf_files, key=lambda p: p.stat().st_mtime)

    def _parse_intelligence_report(self, pdf_path):
        """
        Parse ChatGPT intelligence report PDF
        
        Extracts key metrics:
        - Risk-On probability (0-100%)
        - Liquidity status (FLOODED/NEUTRAL/DRAINING)
        - VIX conditions (contango/backwardation %)
        - Sector leaders
        - Market outlook
        
        Returns dict with macro intelligence
        """
        if not PDF_AVAILABLE:
            print("  [Report] ⚠️  PDF parsing not available (PyPDF2 not installed)")
            return None
        
        try:
            print(f"  [Report] Parsing intelligence report: {pdf_path.name}")
            
            # Read PDF
            with open(pdf_path, 'rb') as f:
                reader = PyPDF2.PdfReader(f)
                full_text = ""
                for page in reader.pages:
                    full_text += page.extract_text()
            
            # Extract key metrics using regex and keyword matching
            macro_data = {
                'risk_on_prob': self._extract_risk_on_probability(full_text),
                'liquidity_status': self._extract_liquidity_status(full_text),
                'vix_contango': self._extract_vix_conditions(full_text),
                'sector_leaders': self._extract_sector_leaders(full_text),
                'market_outlook': self._extract_market_outlook(full_text),
                'report_date': pdf_path.stat().st_mtime
            }
            
            print(f"  [Report] ✓ Parsed successfully")
            return macro_data
            
        except Exception as e:
            print(f"  [Report] ⚠️  Error parsing PDF: {e}")
            return None

    def _extract_risk_on_probability(self, text):
        """
        Extract Risk-On probability from report text
        
        Looks for patterns like:
        - "Risk-On: 75%"
        - "Risk-On probability: 0.75"
        - "75% Risk-On"
        - "Risk-On regime confirmed (HIGH probability)"
        """
        # Try numeric patterns first
        patterns = [
            r'risk[- ]on[:\s]+(\d+)%',
            r'risk[- ]on probability[:\s]+(\d+)%',
            r'(\d+)%\s+risk[- ]on',
            r'risk[- ]on[:\s]+0?\.(\d+)',
        ]
        
        for pattern in patterns:
            match = re.search(pattern, text.lower())
            if match:
                value = match.group(1)
                prob = float(value) if '.' not in pattern else float('0.' + value)
                if prob <= 1.0:
                    prob = prob  # Already decimal
                else:
                    prob = prob / 100  # Convert percentage
                print(f"  [Report] ✓ Risk-On: {prob:.1%}")
                return prob
        
        # Qualitative assessment as fallback
        text_lower = text.lower()
        if 'strong risk-on' in text_lower or 'high risk-on' in text_lower:
            print(f"  [Report] ✓ Risk-On: 80% (qualitative: strong)")
            return 0.80
        elif 'moderate risk-on' in text_lower or 'risk-on confirmed' in text_lower:
            print(f"  [Report] ✓ Risk-On: 70% (qualitative: moderate)")
            return 0.70
        elif 'risk-off' in text_lower or 'defensive' in text_lower:
            print(f"  [Report] ✓ Risk-On: 30% (qualitative: risk-off)")
            return 0.30
        
        print(f"  [Report] ⚠️  Could not extract Risk-On probability, assuming 50%")
        return 0.50

    def _extract_liquidity_status(self, text):
        """
        Extract liquidity status from report
        
        Looks for:
        - "Liquidity: FLOODED/DRAINING/NEUTRAL"
        - "Fed balance sheet expanding/contracting"
        - "WALCL rising/falling"
        """
        text_lower = text.lower()
        
        # Direct status mentions
        if 'liquidity: flooded' in text_lower or 'flooded liquidity' in text_lower:
            print(f"  [Report] ✓ Liquidity: FLOODED")
            return 'FLOODED'
        elif 'liquidity: draining' in text_lower or 'draining liquidity' in text_lower:
            print(f"  [Report] ✓ Liquidity: DRAINING")
            return 'DRAINING'
        elif 'liquidity: neutral' in text_lower:
            print(f"  [Report] ✓ Liquidity: NEUTRAL")
            return 'NEUTRAL'
        
        # Fed balance sheet mentions
        if 'balance sheet expanding' in text_lower or 'walcl rising' in text_lower:
            print(f"  [Report] ✓ Liquidity: FLOODED (balance sheet expanding)")
            return 'FLOODED'
        elif 'balance sheet contracting' in text_lower or 'walcl falling' in text_lower or 'qt continuing' in text_lower:
            print(f"  [Report] ✓ Liquidity: DRAINING (balance sheet contracting)")
            return 'DRAINING'
        
        print(f"  [Report] ⚠️  Could not extract liquidity status, assuming NEUTRAL")
        return 'NEUTRAL'

    def _extract_vix_conditions(self, text):
        """
        Extract VIX contango/backwardation from report
        
        Looks for:
        - "VIX contango: 12%"
        - "VIX backwardation"
        - "VIX futures in steep contango"
        """
        text_lower = text.lower()
        
        # Numeric contango
        patterns = [
            r'vix contango[:\s]+(\d+)%',
            r'contango[:\s]+(\d+)%',
            r'(\d+)%\s+contango',
        ]
        
        for pattern in patterns:
            match = re.search(pattern, text_lower)
            if match:
                contango_pct = float(match.group(1)) / 100
                print(f"  [Report] ✓ VIX Contango: {contango_pct:.1%}")
                return contango_pct
        
        # Qualitative
        if 'steep contango' in text_lower or 'deep contango' in text_lower:
            print(f"  [Report] ✓ VIX Contango: 15% (qualitative: steep)")
            return 0.15
        elif 'contango' in text_lower:
            print(f"  [Report] ✓ VIX Contango: 10% (qualitative: moderate)")
            return 0.10
        elif 'backwardation' in text_lower:
            print(f"  [Report] ✓ VIX Contango: -5% (backwardation)")
            return -0.05
        
        print(f"  [Report] ⚠️  Could not extract VIX conditions, assuming 5%")
        return 0.05

    def _extract_sector_leaders(self, text):
        """
        Extract leading sectors from report
        
        Returns list of sector names
        """
        text_lower = text.lower()
        
        sectors_mentioned = []
        sector_keywords = {
            'technology': 'TECH',
            'tech': 'TECH',
            'financials': 'FINANCIAL',
            'finance': 'FINANCIAL',
            'healthcare': 'DEFENSIVE',
            'consumer staples': 'DEFENSIVE',
            'utilities': 'DEFENSIVE',
            'energy': 'COMMODITY',
            'materials': 'CYCLICAL',
            'industrials': 'CYCLICAL',
        }
        
        for keyword, sector_type in sector_keywords.items():
            if f'{keyword} leading' in text_lower or f'{keyword} outperforming' in text_lower:
