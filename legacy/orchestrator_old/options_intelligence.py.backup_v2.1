            return {'status': 'error', 'message': 'POLYGON_API_KEY not configured', 'signals': []}

        # Load macro intelligence (PDF report or CSVs)
        self.macro_data = self._load_macro_data()
        self.macro_regime, size_multiplier, regime_reason = self._validate_macro_regime(self.macro_data)
        
        # ABORT if RED
        if self.macro_regime == 'RED':
            print(f"\n  [Options] 🛑 SCAN ABORTED - RED REGIME")
            print(f"  [Options] {regime_reason}")
            return {
                'status': 'aborted',
                'message': regime_reason,
                'macro_regime': self.macro_regime,
                'signals': []
            }

        # Get universe
        full_universe, source = self._get_universe()
        print(f"\n  [Options] Universe: {len(full_universe)} tickers")

        # Crabel filter
        if self.crabel_enabled:
            tickers = self._apply_crabel_compression_filter(full_universe)
        else:
            tickers = full_universe

        # Wyckoff scan with macro filtering
        print(f"\n  [Options] Wyckoff scan with 80% filtering...")
        
        signals = []
        scanned = 0
        patterns_found = 0
        macro_filtered = 0

        for ticker in tickers:
            try:
                stock_signal = self._scan_ticker_stock(ticker)
                if not stock_signal:
                    scanned += 1
                    continue

                patterns_found += 1

                sector = self.sector_map.get(ticker, 'UNKNOWN')
                
                sector_allowed, sector_reason, sector_size_adj = self._apply_sector_rules(
                    ticker, sector, self.macro_regime, 
                    self.macro_data.get('liquidity_status') if self.macro_data else 'UNKNOWN'
                )
                
                if not sector_allowed:
                    macro_filtered += 1
                    scanned += 1
                    continue
                
                win_prob = self._calculate_win_probability(
                    stock_signal['wyckoff_score'],
                    self.macro_regime, 
                    self.macro_data.get('liquidity_status') if self.macro_data else 'UNKNOWN',
                    stock_signal['warnings']
                )
                
                # Filter: 80%+ only
                if win_prob < 0.80:
                    macro_filtered += 1
                    scanned += 1
                    continue
                
                timing_readiness = self._assess_timing_readiness(stock_signal)
                signal = {
                    **stock_signal,
                    'sector': sector,
                    'macro_regime': self.macro_regime,
                    'win_probability': win_prob,
                    'position_size_mult': round(size_multiplier * sector_size_adj, 2),
                    'timing_readiness': timing_readiness,
                    'signal_id': f"{ticker}_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
                }
                
                signals.append(signal)
                
                print(f"  [Options] ✅ {ticker} {signal['setup_quality']} "
                      f"(WinProb: {win_prob:.0%})")

                scanned += 1
                time.sleep(0.12)

            except Exception as e:
                scanned += 1
                continue

        print(f"\n  [Options] COMPLETE:")
        print(f"    Regime: {self.macro_regime}")
        print(f"    Scanned: {scanned}")
        print(f"    Patterns: {patterns_found}")
        print(f"    Filtered: {macro_filtered}")
        print(f"    80%+ signals: {len(signals)}")

        if signals:
            csv_path = self._export_signals_to_csv(signals)
            print(f"\n  ✅ Exported to: {csv_path}")

        return {
            'status': 'success',
            'signal_count': len(signals),
            'signals': signals,
            'macro_regime': self.macro_regime,
            'timestamp': datetime.now().isoformat()
        }

    def _scan_ticker_stock(self, ticker):
        """Wyckoff analysis"""
        price_data = self._get_price_history(ticker, days=90)
        if not price_data or len(price_data) < 30:
            return None

        df = pd.DataFrame(price_data)
        df = df.rename(columns={'timestamp': 'date'})

        wyckoff_result = self.wyckoff_engine.analyze(ticker, df)

        if wyckoff_result['setup_quality'] not in ['Grade_A', 'Grade_B']:
            return None

        if wyckoff_result['wyckoff_score'] < self.wyckoff_score_min:
            return None

        if wyckoff_result['trade_direction'] == 'NONE':
            return None

        direction = 'CALL' if wyckoff_result['trade_direction'] == 'LONG' else 'PUT'
        current_price = price_data[-1]['close']

        return {
            'ticker': ticker,
            'setup': wyckoff_result['phase'],
            'setup_quality': wyckoff_result['setup_quality'],
            'direction': direction,
            'wyckoff_score': wyckoff_result['wyckoff_score'],
            'confidence': wyckoff_result['confidence'],
            'stock_price': round(current_price, 2),
            'entry_trigger': wyckoff_result['entry_trigger'],
            'stop_loss': wyckoff_result['stop_loss'],
            'initial_target': wyckoff_result['initial_target'],
            'thrust_pattern': wyckoff_result['thrust_pattern'],
            'volume_activity': wyckoff_result['volume_activity'],
            'warnings': wyckoff_result['warnings'],
        }

    def _assess_timing_readiness(self, signal):
        """Assess timing"""
        entry_trigger = signal.get('entry_trigger', '').lower()
        wyckoff_score = signal.get('wyckoff_score', 0)
        setup_quality = signal.get('setup_quality', '')

        if 'immediately' in entry_trigger or 'enter now' in entry_trigger:
            return 'IMMEDIATE'

        if setup_quality == 'Grade_A' and wyckoff_score >= 90:
            if 'tested' in entry_trigger or 'confirmed' in entry_trigger:
                return 'IMMEDIATE'

        if 'on next' in entry_trigger or 'on pullback' in entry_trigger:
            if wyckoff_score >= 80:
                return 'NEAR_TERM'

        return 'DEVELOPING'

    def _export_signals_to_csv(self, signals):
        """Export signals"""
        reports_dir = Path('reports')
        reports_dir.mkdir(exist_ok=True)

        timestamp = datetime.now().strftime('%Y-%m-%d_%H%M')
        csv_path = reports_dir / f'wyckoff_patterns_{timestamp}.csv'

        fieldnames = [
            'signal_id', 'ticker', 'direction', 'setup', 'setup_quality',
            'wyckoff_score', 'win_probability', 'timing_readiness',
            'stock_price', 'entry_trigger', 'stop_loss', 'initial_target',
            'sector', 'macro_regime', 'position_size_mult', 'scan_date'
        ]

        with open(csv_path, 'w', newline='', encoding='utf-8') as f:
            writer = csv.DictWriter(f, fieldnames=fieldnames)
            writer.writeheader()

            for signal in signals:
                row = {
                    'signal_id': signal.get('signal_id', ''),
                    'ticker': signal.get('ticker', ''),
                    'direction': signal.get('direction', ''),
                    'setup': signal.get('setup', ''),
                    'setup_quality': signal.get('setup_quality', ''),
                    'wyckoff_score': signal.get('wyckoff_score', 0),
                    'win_probability': signal.get('win_probability', 0),
                    'timing_readiness': signal.get('timing_readiness', ''),
                    'stock_price': signal.get('stock_price', 0),
                    'entry_trigger': signal.get('entry_trigger', ''),
                    'stop_loss': signal.get('stop_loss', 0),
                    'initial_target': signal.get('initial_target', 0),
                    'sector': signal.get('sector', ''),
                    'macro_regime': signal.get('macro_regime', ''),
                    'position_size_mult': signal.get('position_size_mult', 1.0),
                    'scan_date': datetime.now().strftime('%Y-%m-%d')
                }

                writer.writerow(row)

        return str(csv_path)

    # Universe & data methods (same as v2.0)
    def _get_universe(self):
        """Get universe"""
        if self.csv_path.exists():
            try:
                tickers = self._load_csv()
                if tickers:
                    return tickers, 'CSV'
            except:
                pass

        try:
            tickers = self._fetch_dynamic_universe()
            if tickers and len(tickers) > 50:
                return tickers, 'Dynamic'
        except:
            pass

        return self._get_static_universe(), 'Static'

    def _load_csv(self):
        """Load CSV"""
        tickers = []
        with open(self.csv_path, 'r', encoding='utf-8') as f:
            reader = csv.DictReader(f)
            for row in reader:
                ticker = row.get('ticker', '').strip().upper()
                if ticker and len(ticker) <= 5:
                    tickers.append(ticker)
        return tickers

    def _fetch_dynamic_universe(self):
        """Fetch dynamic"""
        url = f"{self.base_url}/v2/snapshot/locale/us/markets/stocks/tickers"
        params = {'apiKey': self.polygon_key}

        response = requests.get(url, params=params, timeout=30)
        response.raise_for_status()
        data = response.json()

        if 'tickers' not in data:
            raise Exception("No tickers")

        candidates = []
        for item in data['tickers']:
            ticker = item.get('ticker', '')
            day = item.get('day', {})

            if not day:
                continue

            price = day.get('c', 0)
            volume = day.get('v', 0)

            if (volume > 500000 and 10 <= price <= 2000 and '.' not in ticker and
                '-' not in ticker and len(ticker) <= 5 and ticker.isalpha()):
                candidates.append({'ticker': ticker, 'volume': volume})

        candidates.sort(key=lambda x: x['volume'], reverse=True)
        return [c['ticker'] for c in candidates[:500]]

    def _get_static_universe(self):
        """Static universe"""
        return [
            'AAPL', 'MSFT', 'GOOGL', 'AMZN', 'META', 'NVDA', 'TSLA', 'NFLX', 'AMD', 'CRM',
            'JPM', 'BAC', 'GS', 'V', 'MA', 'BLK', 'C', 'WFC', 'AXP', 'SCHW',
            'SPY', 'QQQ', 'IWM', 'DIA', 'XLF', 'XLE', 'XLK', 'GLD', 'SLV', 'EEM'
        ]

    def _get_price_history(self, ticker, days=90):
        """Get price history"""
        end = datetime.now()
        start = end - timedelta(days=days)

        url = f"{self.base_url}/v2/aggs/ticker/{ticker}/range/1/day/{start.strftime('%Y-%m-%d')}/{end.strftime('%Y-%m-%d')}"
        params = {'apiKey': self.polygon_key}

        try:
            response = requests.get(url, params=params, timeout=10)
            response.raise_for_status()
            data = response.json()

            if 'results' in data and data['results']:
                bars = [{'timestamp': b['t'], 'open': b['o'], 'high': b['h'],
                        'low': b['l'], 'close': b['c'], 'volume': b['v']}
                       for b in data['results']]
                return bars
        except Exception as e:
            pass
        return None

    def log_outcome(self, signal_id, outcome, exit_price, exit_date=None, notes=''):
        """Log trade outcome"""
        if exit_date is None:
            exit_date = datetime.now().strftime('%Y-%m-%d')
        
        with open(self.outcomes_db_path, 'a', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow([
                signal_id, '', '', '', '', '', '', '', '',
                '', '', exit_date, exit_price, outcome, '', '', notes
            ])
        
        print(f"  [Learning] Outcome logged: {signal_id} → {outcome}")