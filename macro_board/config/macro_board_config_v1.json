{
  "config_version": "macro_board_config_v1",
  "recorded_at": "2026-10-06",
  "business_owner": "ACK",
  "approval_note": "ACK 2026-10-06: standalone ETF macro decision board, outside the AVSHUNTER pipeline, reading its data read-only. All thresholds PROVISIONAL until measured on board snapshots.",
  "authority": "STANDALONE_DECISION_SUPPORT_ONLY_NOT_A_PIPELINE_INPUT",
  "horizons_sessions": [
    1,
    5,
    20
  ],
  "history_start": "2020-06-01",
  "board_history_display_sessions": 260,
  "conditions": {
    "change_sessions": 20,
    "zscore_window_sessions": 252,
    "zscore_min_sessions": 126,
    "trend_band_z": 0.5,
    "curve_level_bands_pct": [
      0.0,
      0.5
    ],
    "rationale": "20-session change matches the 1-20 session thesis window; z-score against the trailing year makes 'rising/falling' relative to each series' own recorded volatility rather than a textbook level. Band 0.5 sd keeps roughly the middle third as 'stable'."
  },
  "fred_publication_lag_days": {
    "DGS10": 1,
    "DGS2": 1,
    "SPREAD_2Y10Y": 1,
    "DEXUSEU": 1,
    "WALCL": 1,
    "WTREGEN": 1,
    "RRPONTSYD": 1,
    "rationale": "FRED dates a value by observation date; it is published the next business day (H.4.1 weekly: Wednesday observation, Thursday release). A one-calendar-day lag minimum stops a session from seeing its own same-day print."
  },
  "fred_max_age_days": {
    "daily": 6,
    "weekly": 12
  },
  "evidence": {
    "analog_match_levels": [
      1.0,
      0.9,
      0.8,
      0.7,
      0.6
    ],
    "analog_target_effective_n": 12,
    "min_history_sessions": 500,
    "min_effective_n": 8,
    "min_effective_n_holdout": 3,
    "holdout_fraction": 0.25,
    "lean_t_min": 1.5,
    "lean_min_abs_mean_pct": {
      "1": 0.05,
      "5": 0.25,
      "20": 0.75
    },
    "entry_convention": "NEXT_SESSION_OPEN_TO_CLOSE_H",
    "analog_rationale": "Analog depth is chosen per build: the closest match level (share of today's observed conditions that agree) whose analog set still holds at least analog_target_effective_n independent 20-session windows; never looser than 0.6. 12 windows over the full history leaves ~8 in the train period (min_effective_n).",
    "rationale": "Forward returns start at the next session's open because the board is read after the close/pre-market; overlapping windows are thinned so n_eff counts independent windows; the last quarter of history is held out to check the lean was not fitted to the whole sample.",
    "interval_level": 0.8,
    "interval_rationale": "Student-t interval for the mean on independent windows (thesis review: report uncertainty, the window minimum is only a label)."
  },
  "freshness": {
    "price_max_age_sessions": 2,
    "macro_packet_max_age_hours": 30,
