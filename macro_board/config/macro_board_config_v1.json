  "path_dependent": {
    "groups": [
      "Leveraged & inverse",
      "Volatility products"
    ],
    "lean_horizons_allowed": [
      1
    ],
    "rationale": "Daily-reset and futures-roll products compound along the path; multi-session analog returns do not transfer mechanically (thesis s.14)."
  },
  "extension": {
    "band_sd": 1.5,
    "windows_sessions": [
      5,
      20
    ],
    "rationale": "Move already made, in the ETF's own 20-session realised vol; 1.5 sd marks a run large relative to its recent noise (thesis s.7, Scenario C). Descriptive label only."
  },
  "response": {
    "t_min": 1.0,
    "rationale": "Only condition contrasts with |t| >= 1 count as measured pressure; signs come from the board's own transmission evidence (thesis s.4)."
  },
  "options": {
    "chain_db": "data/phantom/phantom_history.db",
    "target_dte_calendar": {
      "1": 1,
      "5": 7,
      "20": 28
    },
    "max_quote_age_sessions": 2,
    "rationale": "Executable ATM straddle on the first expiry covering the horizon (runway rule), scaled by sqrt(time) to the horizon; compared with the analog mean absolute move (thesis s.8)."
  },
  "pipeline": {
    "runs_dir": "data/output/runs",
    "file": "options/options_candidates_ranked.csv",
    "columns": [
