      "contract_expiry",
      "contract_dte",
      "contract_premium",
      "thesis_state",
      "thesis_move_consumed_factor",
      "direction_arbitration_reason"
    ],
    "rationale": "Answers the desk card's 'What does the pipeline propose?' read-only; the board never changes or re-ranks it."
  },
  "archive_inputs": true,
  "revision_note": "2026-10-06 rev c: issuer holdings (SSGA, Invesco) and tastytrade market metrics.",
  "holdings": {
    "dir": "macro_board/output/holdings",
    "max_age_sessions": 3,
    "top_rows": 15,
    "participation_sessions": 50,
    "sources": {
      "SPY": {
        "issuer": "State Street",
        "format": "ssga_xlsx",
        "url": "https://www.ssga.com/us/en/intermediary/library-content/products/fund-data/etfs/us/holdings-daily-us-en-spy.xlsx"
      },
      "DIA": {
        "issuer": "State Street",
        "format": "ssga_xlsx",
        "url": "https://www.ssga.com/us/en/intermediary/library-content/products/fund-data/etfs/us/holdings-daily-us-en-dia.xlsx"
      },
      "QQQ": {
        "issuer": "Invesco",
        "format": "invesco_json",
        "accept": "application/json",
        "url": "https://dng-api.invesco.com/cache/v1/accounts/en_US/shareclasses/QQQ/holdings/fund?idType=ticker&productType=ETF"
      }
    },
    "rationale": "Issuer daily holdings (ACK 6 Oct 2026): weight x return contribution and weight-share participation answer 'are the holdings that matter supporting the move?' (thesis s.6). Unpriced weight is shown, never treated as zero return."
  },
  "tastytrade": {
    "dir": "macro_board/output/external",
    "max_age_hours": 30,
    "mean_abs_factor": 0.7979,
    "rationale": "Read-only broker metrics via bridge.tastytrade_readonly_mcp (needs the broker OAuth environment). IV-based expected |move| = IV x sqrt(h/252) x sqrt(2/pi), shown beside the executable straddle move."
  }
